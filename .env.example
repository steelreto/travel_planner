# 이 파일을 복사해서 .env 를 만든 뒤 실제 키를 입력하세요.  (cp .env.example .env)
# .env 는 .gitignore 에 포함되어 있어 커밋되지 않습니다. 이 파일(.env.example)에는 실제 키를 절대 쓰지 마세요.

# Google AI Studio 에서 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Kakao Developers > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# (선택) 사용할 Gemini 모델. 비워두면 gemini-3.5-flash-lite
GEMINI_MODEL=
